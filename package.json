{
  "name": "@betterworld/root",
  "private": true,
  "scripts": {
    "dev": "docker compose -f infra/docker-compose.yml up -d --wait && turbo dev",
    "dev:app": "turbo dev --filter=@betterworld/api --filter=@betterworld/web",
    "dev:landing": "turbo dev --filter=landing-page",
    "dev:api": "turbo dev --filter=@betterworld/api",
    "dev:web": "turbo dev --filter=@betterworld/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "db:generate": "pnpm --filter @betterworld/db db:generate",
    "db:migrate": "pnpm --filter @betterworld/db db:migrate",
    "db:push": "pnpm --filter @betterworld/db db:push",
    "db:seed": "pnpm --filter @betterworld/db db:seed",
    "db:studio": "pnpm --filter @betterworld/db db:studio",
    "e2e": "pnpm exec playwright test --project=golden-path",
    "e2e:suites": "pnpm exec playwright test --project=suites",
    "e2e:all": "pnpm exec playwright test"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.8"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-26996"
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
