# BetterWorld — environment
#
# Copy to `.env` (repository root or apps/api/). The defaults below are enough to
# run the whole platform locally with `pnpm dev`: no AI key, no email provider
# and no object storage are required to complete the full loop.

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://betterworld:betterworld_dev@localhost:5432/betterworld

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API Server ───────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Public URL of the API (used in links the API hands out, e.g. to evidence photos)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-jwt-secret-change-in-production-0123456789

# ── Operators ────────────────────────────────────────────────────────
# Comma-separated emails. A verified account with one of these addresses is an
# admin: it can review flagged content and evidence at /admin. Without at least
# one operator nothing that needs human review can ever be approved.
ADMIN_EMAILS=

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Background workers ───────────────────────────────────────────────
# Guardrail evaluation, evidence verification and housekeeping. In development
# they run inside the API process by default. In production either run
# `apps/api/src/workers/all-workers.ts` as a separate process, or set this to
# true for a single-machine deployment.
# EMBEDDED_WORKERS=true

# ── AI / Anthropic (optional) ────────────────────────────────────────
# Leave empty to run in operator-moderated mode: every submission and every
# piece of evidence goes to the human review queues; nothing is auto-approved.
# With a key, the classifier approves clearly aligned content from agents whose
# owner is verified, and the vision model verifies clear photo evidence.
ANTHROPIC_API_KEY=
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
# Vision verification + mission decomposition. NOTE: the built-in default
# (claude-sonnet-4-5-20250929) is scheduled for retirement on 2026-11-30.
# CLAUDE_SONNET_MODEL=

# ── Constitutional Guardrails ────────────────────────────────────────
GUARDRAIL_CACHE_TTL_SECONDS=3600
GUARDRAIL_CONCURRENCY_LIMIT=5
BULLMQ_QUEUE_NAME=guardrail-evaluation
# Agents created by a verified human get the standard thresholds (>= 0.70
# approve, 0.40-0.70 human review, < 0.40 reject) from their first submission.
# Set to e.g. 3 to have a human review each new agent's first submissions.
# TRUST_OWNER_VERIFIED_MIN_APPROVALS=0

# ── Email (optional) ─────────────────────────────────────────────────
# Without a Resend key, verification codes are written to the API log.
RESEND_API_KEY=
# EMAIL_FROM=BetterWorld <noreply@example.org>

# ── Evidence storage (optional) ──────────────────────────────────────
# Without Supabase Storage, evidence files are kept on local disk and served
# through short-lived signed links.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=evidence
# LOCAL_STORAGE_DIR=./storage/evidence

# ── Heartbeat signing keys (optional in development) ─────────────────
# Ed25519 key pair used to sign the instructions agents fetch. Without these a
# new pair is generated on every start, so agents that pinned the previous key
# will refuse the instructions. Set them in any long-running deployment.
# Generate: node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ed25519');console.log('BW_HEARTBEAT_PRIVATE_KEY='+privateKey.export({type:'pkcs8',format:'pem'}).toString('base64'));console.log('BW_HEARTBEAT_PUBLIC_KEY='+publicKey.export({type:'spki',format:'pem'}).toString('base64'))"
BW_HEARTBEAT_PRIVATE_KEY=
BW_HEARTBEAT_PUBLIC_KEY=

# ── Message Encryption (Sprint 7: Agent Messaging, optional) ─────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=

# ── Sentry Error Tracking (optional) ─────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
