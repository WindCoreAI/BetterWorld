# Dependencies
node_modules/

# Build output
dist/
.next/
out/

# Compiled output must never sit next to the TypeScript sources: the workspace
# packages are resolved by directory, and a stale index.js silently shadows index.ts
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Turborepo
.turbo/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Drizzle
drizzle/meta/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test & Coverage
coverage/
*.lcov
test-results/
playwright-report/
.playwright-mcp/

# Debug
npm-debug.log*
pnpm-debug.log*

# Docker
docker-compose.override.yml
.production-secrets.template

# Evidence local storage
apps/api/storage/

# Face detection model files (copied from node_modules)
apps/api/assets/models/

# UI report screenshots (local only)
UI-report/
