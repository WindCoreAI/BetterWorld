# The API reads `.env` from this directory first and from the repository root
# second (real environment variables always win). The documented example with
# every setting explained is the one at the repository root: ../../.env.example
#
# The minimum to start the API and its workers locally:

DATABASE_URL=postgresql://betterworld:betterworld_dev@localhost:5432/betterworld
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-jwt-secret-change-in-production-0123456789
CORS_ORIGINS=http://localhost:3000

# Your email here makes your (verified) account an admin, so you can review
# flagged content and evidence at /admin.
ADMIN_EMAILS=
