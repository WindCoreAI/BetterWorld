# Single-stage build — pnpm install creates proper workspace symlinks for tsx
FROM node:22-slim
RUN corepack enable pnpm

# T030: Non-root user for defense-in-depth (Sprint 20 Security Hardening)
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 betterworld

WORKDIR /app

# Install dependencies first (Docker layer cache on lockfile changes only)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/guardrails/package.json packages/guardrails/
RUN pnpm install --frozen-lockfile

# Copy source and config files
COPY apps/api/src apps/api/src
COPY apps/api/tsconfig.json apps/api/
COPY packages/shared/src packages/shared/src
COPY packages/db/src packages/db/src
COPY packages/guardrails/src packages/guardrails/src
COPY tsconfig.json ./

# Bake face detection models into assets/ for privacy pipeline (T076)
COPY scripts/download-face-models.js scripts/
RUN node scripts/download-face-models.js --copy

ENV NODE_ENV=production

# T030: Run as non-root user
USER betterworld

# No HEALTHCHECK for worker — it does not expose an HTTP server.
# BullMQ workers process jobs from Redis queues and have no health endpoint.
# Worker health is monitored via BullMQ job completion/failure metrics in Sentry.

CMD ["./apps/api/node_modules/.bin/tsx", "apps/api/src/workers/all-workers.ts"]
